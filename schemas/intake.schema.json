{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "operation_type",
    "target_name",
    "analysis_goal",
    "restrictions"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique identifier for the case"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "institutions",
        "individuals",
        "disinformation_campaign",
        "narrative_analysis",
        "data_leak"
      ],
      "description": "Operation purpose that defines the pipeline"
    },
    "target_name": {
      "type": "string"
    },
    "target_url": {
      "type": "string"
    },
    "scope_type": {
      "type": "string"
    },
    "analysis_goal": {
      "type": "string"
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analyst_notes": {
      "type": "string"
    },
    "source_seed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
